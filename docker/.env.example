# Copy this file to `.env` IN THIS DIRECTORY, next to docker-compose.yml.
#
#   cp docker/.env.example docker/.env
#
# It has to live here, not in the repository root. `docker compose -f
# docker/docker-compose.yml` takes this directory as the project directory and
# reads `.env` from it; a file at the root is silently ignored, and the only
# symptom is settings that appear not to apply. To keep it at the root instead,
# name it explicitly:
#
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
#
# Check what actually reached the container with:
#
#   docker compose -f docker/docker-compose.yml config

# Password for the sign-in screen. Leave it out and there is no sign-in at all,
# which is only appropriate while the service is bound to loopback.
# CHAT2DB_COMMUNITY_PASSWORD=change-me-to-something-long

# Host address and port to publish on. 0.0.0.0 exposes the service to the
# network - set a password first.
# CHAT2DB_BIND_ADDRESS=127.0.0.1
# CHAT2DB_PORT=10825

# JVM options, e.g. the heap ceiling.
# CHAT2DB_JAVA_OPTS=-Xmx2g

# Extra browser origins to trust, comma separated. Only needed when a reverse
# proxy hides the address the browser actually used.
# CHAT2DB_COMMUNITY_ALLOWED_ORIGINS=https://db.example.com

# Build every subsystem during startup instead of on first use. Slightly faster
# first page, slower and riskier start.
# CHAT2DB_EAGER_INIT=false
